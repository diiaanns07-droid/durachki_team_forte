# Kassa Sentinel — переменные окружения (A17). Копия: deploy/.env — в git НЕ попадает (.gitignore).
# Секреты (ключи, TUNNEL_TOKEN, HF_TOKEN) — только в deploy/.env на машине; никогда в репо и в чат.
# Пустое значение = default модуля. /app/... windows\_env.ps1 переводит в пути внутри репозитория.

# --- API (A02) ---
SENTINEL_API_KEYS=change-me          # через запятую; setup.ps1 генерирует случайный. Пусто → A02 создаст data/api_keys.txt
SENTINEL_UI_PASSWORD=                # опционально: вход в UI по паролю
SENTINEL_WORKERS=1                   # ОДИН GPU-worker; супервизор выставляет принудительно
SENTINEL_PORT=8000
SENTINEL_TRUSTED_PROXIES=127.0.0.1,::1   # cloudflared локальный → верный IP и флаг Secure у cookie
SENTINEL_MAX_UPLOAD_MB=              # default A02: 300
SENTINEL_BUDGET_S=                   # default A02: 270 (бюджет задачи)
SENTINEL_FAKE_PIPELINE=              # ЗАПРЕЩЕНО в проде (preflight блокирует =1)

# --- пути ---
SENTINEL_DATA_DIR=/app/data
SENTINEL_WEIGHTS=/app/weights
SENTINEL_CACHE_DIR=/app/cache
SENTINEL_LOG_DIR=/app/runs/deploy    # runs/ в .gitignore
SENTINEL_FRONTEND_DIST=/app/frontend/dist
HF_HOME=/app/weights/hf
HF_HUB_CACHE=/app/weights/hf/hub

# --- офлайн: рантайм ничего не скачивает (скрипты выставляют =1 принудительно) ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
SENTINEL_NETGUARD=log                # log (прод: аудит, не блокирует) | block (offline smoke) | off
SENTINEL_NETGUARD_ALLOW=             # доп. разрешённые хосты/CIDR; loopback разрешён всегда

# --- пайплайн (A03) / модули ---
SENTINEL_MOCK=0                      # 1 = фиктивные модели: только тесты/демо; preflight блокирует
SENTINEL_DEVICE=                     # default auto
SENTINEL_EXECUTOR=                   # default process (spawn-воркер — единственный владелец GPU)
SENTINEL_VLM_POLICY=                 # default auto | keep | on_demand | off
SENTINEL_NO_VLM=                     # 1 — без VLM (preflight понижает Qwen3-VL до опциональной)
SENTINEL_PIPELINE_CONFIG=            # оверлей; гипотеза VRAM: deploy/config/pipeline_vram_measured.yaml (ВЫКЛ)
SENTINEL_CACHE=                      # A03: off — для замеров SLA (иначе повтор роликов из кэша стадий)
COPILOT_ENABLED=0                    # копилот выключен: GPU — анализу (deploy/VRAM.md)

# --- deploy (A17) ---
SENTINEL_DEPLOY_CONFIG=              # default deploy/config/deploy.yaml
SENTINEL_TUNNEL_MODE=                # default из deploy.yaml: quick | named | off
TUNNEL_TOKEN=                        # только для named tunnel (start.ps1 -Named); передаётся через env, не argv
CLOUDFLARED_PROTOCOL=                # пусто = auto; http2, если сеть площадки режет UDP/QUIC

# --- только подготовка весов (онлайн-шаг), не рантайм ---
HF_TOKEN=
