# Профиль pose_rules (L2). Подключение: SENTINEL_PROFILE=pose_rules в deploy/.env (или в окружении) —
# deploy/windows/_env.ps1 и tools/l2/run_profile.py накладывают этот файл поверх deploy/.env.
# Пути /app/... отображаются в корень репозитория. Секретов здесь нет.
SENTINEL_PIPELINE_CONFIG=/app/backend/pipeline/profiles/pose_rules.yaml
SENTINEL_POSE_CONFIG=/app/ml/pose/presets/pose_rules.yaml
SENTINEL_DETECT_EXTRAS=open_vocab
